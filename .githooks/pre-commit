#!/usr/bin/env bash
set -euo pipefail

echo "🔍 Scanning staged files for secrets..."

declare -a STAGED_FILES=()
while IFS= read -r -d '' FILE; do
    STAGED_FILES+=("$FILE")
done < <(git diff --cached --name-only --diff-filter=ACMRT -z 2>/dev/null)

if command -v gitleaks &>/dev/null; then
    if ! gitleaks protect --staged --no-banner --exit-code 1; then
        echo ""
        echo "❌ Potential secrets detected in staged files."
        echo "   Review the findings above before committing."
        echo "   False positive? Override with: git commit --no-verify"
        exit 1
    fi
else
    echo "⚠️  gitleaks not installed — running basic pattern scan."
    echo "   Install for comprehensive detection: brew install gitleaks"
    echo ""

    if [ "${#STAGED_FILES[@]}" -eq 0 ]; then
        echo "✅ No staged files to scan."
        exit 0
    fi

    # Common high-signal secret patterns
    declare -a PATTERNS=(
        'AKIA[0-9A-Z]{16}'                              # AWS access key ID
        'sk-[a-zA-Z0-9]{48}'                            # OpenAI secret key
        'sk-ant-api[0-9]{2}-[a-zA-Z0-9_-]{93,}'        # Anthropic secret key
        'ghp_[a-zA-Z0-9]{36}'                           # GitHub personal access token
        'ghs_[a-zA-Z0-9]{36}'                           # GitHub Actions token
        'xoxb-[0-9]+-[0-9]+-[a-zA-Z0-9]+'              # Slack bot token
        '-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY'    # Private key block
        'eyJ[a-zA-Z0-9_-]+\.[a-zA-Z0-9_-]+\.[a-zA-Z0-9_-]+' # JWT
        '[0-9a-f]{40}'                                  # 40-char hex (API token shape)
    )

    FOUND=0
    for FILE in "${STAGED_FILES[@]}"; do
        for PATTERN in "${PATTERNS[@]}"; do
            if git diff --cached -- "$FILE" | grep -qE "^\+.*${PATTERN}" 2>/dev/null; then
                echo "❌ Potential secret in: $FILE  (pattern: ${PATTERN:0:30}...)"
                FOUND=1
            fi
        done
    done

    if [ "$FOUND" -eq 1 ]; then
        echo ""
        echo "Commit blocked. Review the above."
        echo "False positive? Override with: git commit --no-verify"
        exit 1
    fi
fi

echo "✅ No secrets detected."

if [ "${#STAGED_FILES[@]}" -eq 0 ]; then
    exit 0
fi

HAS_RUST=false
HAS_PHP=false
HAS_FRONTEND=false

for FILE in "${STAGED_FILES[@]}"; do
    case "$FILE" in
        Cargo.toml|Cargo.lock|backend/*|mcp-server/*)
            HAS_RUST=true
            ;;
    esac

    case "$FILE" in
        *.php)
            HAS_PHP=true
            ;;
    esac

    case "$FILE" in
        resources/*.ts|resources/*.tsx|resources/*.js|resources/*.jsx|resources/*.css|package.json|package-lock.json|tsconfig.json|eslint.*|prettier.*)
            HAS_FRONTEND=true
            ;;
    esac
done

if [ "$HAS_RUST" = true ]; then
    export PATH="/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH"

    if ! command -v cargo &>/dev/null; then
        echo "❌ Rust files are staged, but cargo is not installed or not on PATH."
        echo "   Install Rust with rustup, then retry the commit."
        exit 1
    fi

    echo "🦀 Running Rust and CLI pre-commit checks..."

    cargo fmt --all -- --check
    cargo check --workspace --locked
    cargo check -p artfct-backend --target wasm32-unknown-unknown --locked
    cargo clippy --workspace --all-targets --locked -- -D warnings
    cargo test -p artfct --locked
    cargo run -p artfct --locked -- doctor >/dev/null

    echo "✅ Rust and CLI checks passed."
fi

if [ "$HAS_PHP" = true ]; then
    if [ ! -f vendor/bin/pint ]; then
        echo "❌ PHP files are staged, but pint is not installed."
        echo "   Run: composer install"
        exit 1
    fi

    echo "🐘 Running PHP pre-commit checks..."
    vendor/bin/pint --test --format agent
    echo "✅ PHP checks passed."
fi

if [ "$HAS_FRONTEND" = true ]; then
    if ! command -v npx &>/dev/null; then
        echo "❌ Frontend files are staged, but npx is not available."
        echo "   Ensure Node.js is installed."
        exit 1
    fi

    echo "🎨 Running frontend pre-commit checks..."
    npm run format:check
    npm run lint:check
    npm run types:check
    echo "✅ Frontend checks passed."
fi

exit 0
