#!/usr/bin/env bash
set -euo pipefail

# Runs the same checks CI runs, before code leaves this machine. Unlike
# pre-commit (which only checks files staged in *this* commit), this always
# runs the full workspace: two real CI failures on 2026-09-22 slipped past
# pre-commit because neither touched the files that failed — a clippy
# toolchain drift in files nobody had staged in months, and a missing
# `npm run build` step that only a full test run exercises. Bypass with
# `git push --no-verify` when you know what you're doing (e.g. pushing a
# docs-only branch and want to skip the Rust/PHP gates).
#
# The one built-in exception: a push that changes only release/CI plumbing
# (see scripts/pre-push-scope.sh) runs just the Node tests for those scripts,
# because no PHP, Rust or frontend test reads those files.

export PATH="/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH"

# Git passes the refs being pushed on stdin; read them before anything else.
push_refs="$(cat)"
repository_root="$(git rev-parse --show-toplevel)"
cd "$repository_root"

push_scope="full"
if [ -f scripts/pre-push-scope.sh ]; then
    push_scope="$(bash scripts/pre-push-scope.sh <<< "$push_refs" || echo full)"
fi

if [ "$push_scope" = "light" ]; then
    echo "⚡ Only release/CI plumbing changed; running its Node tests instead of the full workspace."
    npm run test:release --silent
    npm run test:staging --silent
    if command -v actionlint &>/dev/null; then
        actionlint
    else
        echo "⏭  actionlint not installed; CI runs it."
    fi
    echo "✅ All pre-push checks passed."
    exit 0
fi

# Fail before the slow Rust step if a fresh checkout or worktree has no dependencies.
if [ ! -f vendor/autoload.php ] || [ ! -d node_modules ]; then
    echo "❌ vendor/ or node_modules/ is missing. Run: composer install && npm ci"
    exit 1
fi

echo "🦀 Rust workspace (fmt, clippy, wasm target, tests)..."
if ! command -v cargo &>/dev/null; then
    echo "❌ cargo is not installed or not on PATH."
    exit 1
fi
cargo fmt --all -- --check
cargo clippy --workspace --all-targets --locked -- -D warnings
cargo check -p artfct-backend --target wasm32-unknown-unknown --locked
cargo test --workspace --locked
echo "✅ Rust workspace checks passed."

echo "🎨 Frontend (format, lint, types, build)..."
if ! command -v npx &>/dev/null; then
    echo "❌ npx is not available; ensure Node.js is installed."
    exit 1
fi
php artisan wayfinder:generate --no-interaction
npm run format:check
npm run lint:check
npm run types:check
# Built the way production builds it (see the CI step of the same name).
APP_ENV=production npm run build:ssr
echo "✅ Frontend checks passed."

echo "🐘 PHP (style, full Pest suite against a CI-like .env)..."
# CI builds its .env with `cp .env.example .env && php artisan key:generate`, so
# the suite must pass against exactly that. Running it against a developer's own
# .env hid a real failure (2026-10-19): a line added to .env.example turned dev
# login off in CI only, while every local run, which had dev login on, passed.
# The original .env is put back on any exit, including a failing test run.
env_backup=""
if [ -f .env ]; then
    env_backup="$(mktemp)"
    cp .env "$env_backup"
fi
restore_env() {
    if [ -n "$env_backup" ]; then
        cp "$env_backup" .env
        rm -f "$env_backup"
    else
        rm -f .env
    fi
}
trap restore_env EXIT
cp .env.example .env
php artisan key:generate --no-interaction --quiet
if [ ! -f vendor/bin/pint ]; then
    echo "❌ vendor/bin/pint not found. Run: composer install"
    exit 1
fi
vendor/bin/pint --parallel --test --format agent
php -d memory_limit=512M vendor/bin/pest --parallel --compact
restore_env
trap - EXIT
echo "✅ PHP checks passed."

if [ "${MCP_E2E_PRE_PUSH:-false}" = "true" ]; then
    echo "🔌 Local MCP end-to-end stack (Postgres + Worker + hosted OAuth)..."
    scripts/mcp-e2e-stack.sh run
    echo "✅ MCP end-to-end checks passed."
else
    echo "⏭  Skipping the local MCP e2e stack (set MCP_E2E_PRE_PUSH=true to include it; it's what mcp_e2e CI runs, needs Docker, and takes ~30s)."
fi

echo "✅ All pre-push checks passed."
