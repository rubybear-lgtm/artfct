{
    "_comment": "Every Laravel route that does not carry a {team} or {current_team} parameter, and every /ops route (which does, but is never a team route), by how it is protected. Team routes are classified automatically and attacked by the matrix. A route missing from this file fails the isolation run (RUB-435): add it here with the right class, and make sure the class's check really applies. Classes: public (no sign-in by design), guest (sign-in flow), user (needs a signed-in user, not tied to a team), token (needs an org bearer token), signed (needs a signature or shared secret), dev-only (only registered outside production), staff (the operator console under /ops: every route must answer a plain 404 to a signed-out visitor and to a signed-in user who is not staff, and only /ops routes may carry this class).",
    "laravel": {
        "GET .well-known/jwks.json": "public",
        "GET .well-known/mcp/server-card.json": "public",
        "GET .well-known/oauth-authorization-server": "public",
        "GET .well-known/oauth-authorization-server/{path}": "public",
        "GET .well-known/oauth-protected-resource": "public",
        "GET .well-known/oauth-protected-resource/{path}": "public",
        "GET /": "public",
        "POST _boost/browser-logs": "dev-only",
        "GET a/{artifactId}": "public",
        "GET a/{artifactId}/v/{version}": "public",
        "GET a/{artifactId}/download": "user",
        "PATCH a/{artifactId}/sharing": "user",
        "POST a/{artifactId}/comments": "user",
        "PATCH a/{artifactId}/comments/{commentId}": "user",
        "GET api/collections": "token",
        "POST api/collections": "token",
        "POST api/collections/{collection}/artifacts": "token",
        "POST api/mcp/connections": "token",
        "POST api/mcp/connections/heartbeat": "token",
        "POST api/search": "token",
        "POST api/slack/commands": "signed",
        "GET authenticate": "guest",
        "POST authkit/dev-login": "guest",
        "GET blog": "public",
        "GET blog/{retired}": "public",
        "GET blog/{slug}": "public",
        "GET connect": "public",
        "GET connect/{tool}": "public",
        "GET docs": "public",
        "GET free": "public",
        "POST internal/worker-events": "signed",
        "DELETE invitations/{invitation}": "user",
        "GET invitations/{invitation}": "public",
        "POST invitations/{invitation}/accept": "user",
        "POST invitations/{invitation}/join": "guest",
        "GET llms-full.txt": "public",
        "GET llms.txt": "public",
        "GET login": "guest",
        "POST logout": "user",
        "DELETE mcp": "token",
        "GET mcp": "token",
        "POST mcp": "token",
        "GET media/landing/{file}": "public",
        "GET oauth/authorize": "guest",
        "POST oauth/authorize": "user",
        "GET oauth/organizations": "token",
        "POST oauth/register": "public",
        "POST oauth/revoke": "public",
        "POST oauth/token": "public",
        "GET onboarding/team": "user",
        "GET ops": "staff",
        "GET ops/health": "staff",
        "GET ops/tenants/{team}": "staff",
        "POST ops/tenants/{team}/erase": "staff",
        "POST ops/tenants/{team}/erase/preview": "staff",
        "POST ops/tenants/{team}/limits": "staff",
        "POST ops/tenants/{team}/plan": "staff",
        "POST ops/tenants/{team}/reindex": "staff",
        "POST ops/{any?}": "staff",
        "PUT ops/{any?}": "staff",
        "PATCH ops/{any?}": "staff",
        "DELETE ops/{any?}": "staff",
        "OPTIONS ops/{any?}": "staff",
        "GET privacy": "public",
        "DELETE settings/account": "user",
        "GET settings/account": "user",
        "PATCH settings/account": "user",
        "GET settings/teams": "user",
        "POST settings/teams": "user",
        "GET robots.txt": "public",
        "GET sitemap.xml": "public",
        "GET storage/{path}": "signed",
        "PUT storage/{path}": "signed",
        "GET terms": "public",
        "GET terms/accept": "user",
        "POST terms/accept": "user",
        "GET up": "public",
        "POST webhooks/polis": "signed",
        "POST webhooks/stripe": "signed"
    },
    "team_exceptions": {
        "_comment": "Routes that carry a {team} parameter but are meant for people who are not (yet) members: the team's SSO sign-in. They may only redirect (302) or 404 and must never return team data. A new entry here needs a reason.",
        "GET teams/{team}/sso/login": "starts the team's SSO sign-in; redirects to the identity provider",
        "GET teams/{team}/sso/authenticate": "SSO callback; redirects after checking the one-time state"
    }
}
