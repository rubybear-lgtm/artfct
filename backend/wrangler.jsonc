{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "artfct-engine",
    "account_id": "c630a56af756f229176fc46b6bd2326f",
    "main": "build/worker/shim.mjs",
    "compatibility_date": "2026-06-03",
    "build": {
        "command": "cd backend 2>/dev/null || true; PATH=/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH cargo install -q worker-build --version 0.8.3 --root ./target/worker-tools && PATH=/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:./target/worker-tools/bin:$PATH worker-build --release",
    },
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
    },
    "routes": [
        {
            "pattern": "artfct.dev/v1/*",
            "zone_name": "artfct.dev",
        },
        {
            "pattern": "artfct.dev/p/*",
            "zone_name": "artfct.dev",
        },
        // RUB-365: isolated artifact origins, `<tenant-slug>--<artifact-id>.artfct.dev`
        // (spec 05). The whole host is one label, so the staging entry's
        // `*--stg.artfct.dev/*` cannot be translated literally: Cloudflare route
        // patterns allow one wildcard and it must begin the hostname — the
        // literal translation `*--*.artfct.dev/*` is an infix wildcard and
        // invalid, and production's suffix has no marker after the artifact id
        // to anchor a literal. This leading-wildcard form is the only expressible
        // one, and it is wider than the scheme: it matches every other
        // single-label subhost of the zone. `staging.artfct.dev` is one of
        // them, so it must have its own route (or move to the marker-suffix
        // scheme) before this pattern is deployed; otherwise this Worker
        // intercepts staging's requests and its origin never sees them.
        // Reuses the zone's `*.artfct.dev` Universal SSL certificate and DNS
        // wildcard record rather than a second wildcard level.
        {
            "pattern": "*.artfct.dev/*",
            "zone_name": "artfct.dev",
        },
    ],
    "kv_namespaces": [
        {
            "binding": "ARTIFACTS_KV",
            "id": "89447fa353bd403abdcffbce5e5c331b",
        },
    ],
    "d1_databases": [
        {
            "binding": "ARTIFACTS_DB",
            "database_name": "artfct-artifacts",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [
        {
            "binding": "ARTIFACTS_BUCKET",
            "bucket_name": "artfct-blobs",
        },
    ],
    "vars": {
        "ARTFCT_PUBLIC_BASE_URL": "https://artfct.dev",
        "ARTFCT_JWT_ISSUER": "https://artfct.dev",
        "ARTFCT_JWT_AUDIENCE": "artfct-engine",
        "ARTFCT_MAX_HTML_BYTES": "1048576",
        "ARTFCT_DEFAULT_TTL_MINUTES": "7200",
        "ARTFCT_MAX_TTL_MINUTES": "525600",
    },
}
