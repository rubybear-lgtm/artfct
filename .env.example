APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_WORKER_URL=http://localhost:8787

# WorkOS AuthKit — self-serve auth (spec 06). Fail-closed: AuthKitClientContract's
# real implementation throws if client_id/secret/redirect_url are unset, the same
# pattern as ARTFCT_ORG_TOKEN. Local/test environments bind FakeAuthKitClient
# instead (see AppServiceProvider) and never need these set.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URL="${APP_URL}/authenticate"

# Shared secret for the Worker -> Laravel event channel (POST /internal/worker-events).
ARTFCT_WORKER_EVENT_SECRET=

# Slack app signing secret; unset means every Slack request is rejected (401).
SLACK_SIGNING_SECRET=

# Event-driven indexing (RUB-315). Leave false until the real renderer/embeddings/vector index exist.
INDEXING_ENABLED=false
ARTFCT_WORKER_BASE_URL=
ARTFCT_ORG_TOKEN=

# Laravel -> Worker limits push (RUB-310).
ARTFCT_LIMITS_WRITE_SECRET=

# Governance routes shared secret (RUB-317); unset fails closed.
ARTFCT_GOVERNANCE_SECRET=

# Signed links to isolated artifact origins (RUB-365, spec 05). Shared HMAC
# secret with the Worker's ARTFCT_ARTIFACT_TOKEN_SECRET binding; unset fails
# closed, so the console renders no open control.
ARTFCT_ARTIFACT_TOKEN_SECRET=
# Staging only: mirrors the Worker's ARTFCT_ARTIFACT_ORIGIN_SUFFIX override.
# Unset keeps the production `.artfct.dev` suffix.
ARTFCT_ARTIFACT_ORIGIN_SUFFIX=
# How long a minted artifact link stays valid, in minutes.
ARTFCT_ARTIFACT_TOKEN_TTL_MINUTES=60

# Synthetic test data (RUB-325); see config/synthetic.php. Staging values are used only with --target=staging.
SYNTHETIC_STAGING_URL=
SYNTHETIC_STAGING_TOKEN=
SYNTHETIC_STAGING_GOVERNANCE=
SYNTHETIC_STAGING_LIMITS=
